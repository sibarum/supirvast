<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.supirvast</groupId>
        <artifactId>supir-vast</artifactId>
        <version>0.2.2-SNAPSHOT</version>
    </parent>

    <artifactId>vastir-tools</artifactId>

    <name>Supir-Vast :: vastir-tools</name>
    <description>
        A runtime API to validate, disassemble, and cross-compile SPIR-V produced by the vastir emitter, over the
        native SPIR-V toolchain (SPIRV-Tools: spirv-val/dis/as/opt, and SPIRV-Cross). The binaries come from a
        vastir-tools-&lt;os&gt; module, which the OS-activated profiles below add; the runtime extracts and invokes
        them as processes. Where there is no such module for the OS, the tools are unavailable.
    </description>

    <dependencies>
        <dependency>
            <groupId>dev.supirvast</groupId>
            <artifactId>vastir</artifactId>
        </dependency>
        <!-- For the differential harness: lower the same core IR to an executable Truffle AST. -->
        <dependency>
            <groupId>dev.supirvast</groupId>
            <artifactId>vast</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Vulkan compute dispatch to execute our SPIR-V on the GPU: the stack's one Panama binding, so that a
             context can run on a device somebody else made and share its buffers with whatever draws. -->
        <dependency>
            <groupId>dev.supirvast</groupId>
            <artifactId>vastir-vulkan</artifactId>
        </dependency>
    </dependencies>

    <!-- Where the Vulkan loader is: exactly one vastir-vulkan OS module, picked by the build host's OS. -->
    <profiles>
        <profile>
            <id>platform-windows</id>
            <activation><os><family>windows</family></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.supirvast</groupId>
                    <artifactId>vastir-vulkan-windows</artifactId>
                    <scope>runtime</scope>
                </dependency>
                <!-- And the SPIR-V tools for Windows. -->
                <dependency>
                    <groupId>dev.supirvast</groupId>
                    <artifactId>vastir-tools-windows</artifactId>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>platform-linux</id>
            <activation><os><family>unix</family><name>linux</name></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.supirvast</groupId>
                    <artifactId>vastir-vulkan-linux</artifactId>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
