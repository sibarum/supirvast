<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.supirvast</groupId>
        <artifactId>supir-vast</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>supirvast-maven-plugin</artifactId>
    <packaging>maven-plugin</packaging>

    <name>Supir-Vast :: Maven Plugin</name>
    <description>
        Pre-compiles ShaderSource implementations to SPIR-V during the build. The compile-shaders goal runs
        after classes are compiled, discovers ShaderSource implementations on the project classpath, lowers
        each with CoreToSpirv, and writes the binaries into the module's output directory as classpath
        resources (META-INF/supirvast/shaders/&lt;name&gt;.spv) — loaded at runtime via Shaders.load(name)
        without re-lowering. The plugin invokes the compiler reflectively inside the project's own classpath,
        so it carries no vastir dependency and never clashes with the project's vastir version.
    </description>

    <properties>
        <!-- The mojo runs inside arbitrary consumers' Maven JVMs; keep its bytecode conservative (this also
             keeps maven-plugin-plugin's ASM-based descriptor extraction off bleeding-edge class files). -->
        <maven.compiler.release>17</maven.compiler.release>
        <maven-plugin-tools.version>3.15.1</maven-plugin-tools.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>3.9.9</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>3.9.9</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>${maven-plugin-tools.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <version>${maven-plugin-tools.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
