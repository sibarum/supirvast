<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.supirvast</groupId>
        <artifactId>supir-vast</artifactId>
        <version>0.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>vastir-preview</artifactId>

    <name>Supir-Vast :: vastir-preview</name>
    <description>
        A windowed Vulkan shader previewer (an application, not a library). Loads a vertex+fragment SPIR-V pair
        exported by SupirVast and a 3D model from the command line, then renders the model with those shaders on
        live hardware in a resizable window and can dump a PNG screenshot. This is the first SupirVast path that
        actually rasterizes graphics output — vertex/fragment shaders are otherwise only validated and
        cross-compiled, never drawn.
    </description>

    <properties>
        <!-- The only LWJGL in SupirVast. Applications must never depend on this module (it is not installed or
             deployed: see the skip flags), so LWJGL cannot reach one — the framework's builder bans it too. -->
        <lwjgl.version>3.3.6</lwjgl.version>
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Manages lwjgl + lwjgl-vulkan + lwjgl-glfw + lwjgl-stb and their native classifiers together. -->
            <dependency>
                <groupId>org.lwjgl</groupId>
                <artifactId>lwjgl-bom</artifactId>
                <version>${lwjgl.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
          vastir-tools brings the GraphicsPipelineSpec contract and the native SPIR-V toolchain
          (NativeTools.validate, to gate a loaded .spv before pipeline build), and transitively the vastir IR.
        -->
        <dependency>
            <groupId>dev.supirvast</groupId>
            <artifactId>vastir-tools</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
          LWJGL's Vulkan, which this previewer builds its graphics pipeline with. vastir-tools used to bring it
          along, because its compute context was on LWJGL; that is on the stack's own Panama binding now
          (vastir-vulkan), so this declares what it uses. This module is where LWJGL still is, and the window
          below it — GLFW, which the stack's own windowing replaces — is what porting it off would start with.
        -->
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-vulkan</artifactId>
        </dependency>
        <!-- lwjgl-vulkan dlopens the system Vulkan loader, so only the core natives are needed. -->
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl</artifactId>
            <classifier>natives-windows</classifier>
            <scope>runtime</scope>
        </dependency>

        <!-- Windowing + surface creation for the swapchain (the headless compute path needs none of this). -->
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-glfw</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-glfw</artifactId>
            <classifier>natives-windows</classifier>
            <scope>runtime</scope>
        </dependency>

        <!-- stb_image_write for PNG screenshots of the rendered frame. -->
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-stb</artifactId>
        </dependency>
        <dependency>
            <groupId>org.lwjgl</groupId>
            <artifactId>lwjgl-stb</artifactId>
            <classifier>natives-windows</classifier>
            <scope>runtime</scope>
        </dependency>

        <!-- Pure-Java MVP matrix math (no natives). -->
        <dependency>
            <groupId>org.joml</groupId>
            <artifactId>joml</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Pre-compile the ShaderSource implementations (ModelShaders) to SPIR-V after compilation. The
              binaries land in target/classes/META-INF/supirvast/shaders/ and ship in the jar; at runtime
              Shaders.load("model.vert") / loadOrLower(...) reads them as resources instead of re-lowering.
            -->
            <plugin>
                <groupId>dev.supirvast</groupId>
                <artifactId>supirvast-maven-plugin</artifactId>
                <version>${project.version}</version>
                <executions>
                    <execution>
                        <id>precompile-shaders</id>
                        <goals>
                            <goal>compile-shaders</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
